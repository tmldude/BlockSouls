{
	"schemaVersion": 1,
	"id": "blocksouls_world",
	"version": "${version}",
	"name": "BlockSouls World",
	"description": "Scrap, ores, wrecks and ruins, the infected Nether, loot, enchantments and armor.",
	"authors": [
		"tmldude"
	],
	"license": "MIT",
	"contact": {
		"sources": "https://github.com/tmldude/blocksouls"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.tmldude.blocksouls.world.BlockSoulsWorld"
		],
		"client": [
			"io.github.tmldude.blocksouls.world.client.BlockSoulsWorldClient"
		]
	},
	"mixins": [
		"blocksouls_world.mixins.json",
		{
			"config": "blocksouls_world.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"blocksouls_common": "*"
	}
}
