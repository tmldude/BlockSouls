{
	"schemaVersion": 1,
	"id": "blocksouls_movement",
	"version": "${version}",
	"name": "BlockSouls Movement",
	"description": "Mario-style jumps, dodge roll, wall climbing and web swinging.",
	"authors": [
		"tmldude"
	],
	"license": "MIT",
	"contact": {
		"sources": "https://github.com/tmldude/blocksouls"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.tmldude.blocksouls.movement.BlockSoulsMovement"
		],
		"client": [
			"io.github.tmldude.blocksouls.movement.client.BlockSoulsMovementClient"
		]
	},
	"mixins": [
		"blocksouls_movement.mixins.json",
		{
			"config": "blocksouls_movement.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"blocksouls_common": "*"
	}
}
