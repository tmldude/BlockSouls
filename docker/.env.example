# Copy to .env (never commit .env).

# Comma-separated Minecraft usernames allowed to join.
WHITELIST=
# Comma-separated usernames to make server operators.
OPS=
# Any long random string, e.g. `openssl rand -hex 24`. Shared by the server and the backup service.
RCON_PASSWORD=
# Image tag to run: latest, or a release tag like v0.1.0.
BLOCKSOULS_TAG=latest
