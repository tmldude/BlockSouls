{
	"schemaVersion": 1,
	"id": "blocksouls_game",
	"version": "${version}",
	"name": "BlockSouls Game",
	"description": "The run: day/night waves, downed/revive, boons, starting kit, difficulty and endless mode.",
	"authors": [
		"tmldude"
	],
	"license": "MIT",
	"contact": {
		"sources": "https://github.com/tmldude/blocksouls"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.tmldude.blocksouls.game.BlockSoulsGame"
		],
		"client": [
			"io.github.tmldude.blocksouls.game.client.BlockSoulsGameClient"
		]
	},
	"mixins": [
		"blocksouls_game.mixins.json",
		{
			"config": "blocksouls_game.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"blocksouls_common": "*"
	}
}
